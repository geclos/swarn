{
  "name": "swarn",
  "version": "0.1.0",
  "description": "Agentic swarm platform — execute plans with parallel worker agents",
  "type": "module",
  "bin": {
    "swarn": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "tc": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format src --write",
    "check": "biome check src --write"
  },
  "dependencies": {
    "@opencode-ai/sdk": "latest",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}
